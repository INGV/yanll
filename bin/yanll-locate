#!/usr/bin/env python3
"""Locate one event with NonLinLoc from a JSON document.

Reads the input document (a file, or stdin with `-`), writes the observation file,
fills the model's control-file template (${YANLL_CONFIG}/models/<model>/locate.in),
generates the travel-time grids the stations need (yanll-make-grids), runs NLLoc and
writes the location as a JSON document on stdout. See docs/json-schema.md for the
documents and docs/configuration.md for the configuration.

Exit codes: 0 located, 1 NLLoc did not locate (the document reports its status and
message), 2 invalid input or configuration, 3 grid generation or NLLoc failure.
"""
import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import yanlllib as y  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", help="input JSON file, or - for stdin")
    ap.add_argument("-o", "--output", help="output JSON file (default stdout)")
    ap.add_argument("--keep", action="store_true", help="keep the work directory under $YANLL_DATA/locate and name it on stderr")
    args = ap.parse_args()

    try:
        if args.input == "-":
            doc = json.load(sys.stdin)
        else:
            with open(args.input) as f:
                doc = json.load(f)
        run = y.validate_input(doc)
        y.check_config(run["model"])
    except (json.JSONDecodeError, OSError) as e:
        print(f"yanll-locate: cannot read input: {e}", file=sys.stderr)
        return 2
    except y.InputError as e:
        print(f"yanll-locate: invalid input: {e}", file=sys.stderr)
        return 2
    except y.ConfigError as e:
        print(f"yanll-locate: configuration: {e}", file=sys.stderr)
        return 2

    model = run["model"]
    root = f"{run['event_id']}_{run['origin_id']}" if "event_id" in run and "origin_id" in run else "event"
    os.makedirs(os.path.join(y.DATA, "locate"), exist_ok=True)
    workdir = tempfile.mkdtemp(prefix=f"{root}-", dir=os.path.join(y.DATA, "locate"))
    obs_path = os.path.join(workdir, f"{root}.phsnll")
    out_root = os.path.join(workdir, root)
    time_root = os.path.join(y.DATA, "time", model, "time")
    # The control file is rendered before the grids: a broken template fails in a
    # second, not after minutes of Grid2Time.
    try:
        control = y.locate_control(model, obs_path, time_root, out_root, run["station_corrections"])
    except y.ConfigError as e:
        print(f"yanll-locate: configuration: {e}", file=sys.stderr)
        shutil.rmtree(workdir)
        return 2
    y.write_obs(run["observations"], obs_path)

    stations = sorted({o["station"] for o in run["observations"]})
    log_path = os.path.join(workdir, "make-grids.log")
    with open(log_path, "w") as log:
        r = subprocess.run(["yanll-make-grids", model] + stations, stdout=log, stderr=subprocess.STDOUT)
    if r.returncode != 0:
        # The grid script's own messages (a missing model body, a bad template) are the
        # ones that name the cause: repeat them, the rest of the log stays in the file.
        # Its exit 2 is a configuration error and stays 2 here; anything else is NLL.
        with open(log_path) as f:
            for line in f:
                if line.startswith("yanll-make-grids:"):
                    sys.stderr.write(line)
        print(f"yanll-locate: grid generation failed, see {log_path}", file=sys.stderr)
        return 2 if r.returncode == 2 else 3

    control_path = os.path.join(workdir, f"{root}_loc.in")
    with open(control_path, "w") as f:
        f.write(control)
    with open(os.path.join(workdir, "nlloc.log"), "w") as log:
        r = subprocess.run(["NLLoc", control_path], stdout=log, stderr=subprocess.STDOUT)
    hyps = [h for h in glob.glob(os.path.join(workdir, "*.grid0.loc.hyp")) if ".sum." not in h]
    if r.returncode != 0:
        print(f"yanll-locate: NLLoc failed (exit {r.returncode}), see {workdir}/nlloc.log", file=sys.stderr)
        return 3

    result = {k: run[k] for k in ("model", "station_corrections", "event_id", "origin_id") if k in run}
    if hyps:
        result.update(y.hyp_to_json(y.parse_hyp(hyps[0])))
    else:
        # NLLoc skips an event with too few phases without writing a hyp: report its
        # warnings as the status instead of failing.
        with open(os.path.join(workdir, "nlloc.log")) as f:
            warnings = [line.strip() for line in f if line.startswith("WARNING")]
        result["nll"] = {"version": None, "status": "NOT_LOCATED", "message": " ".join(warnings) or "NLLoc wrote no location"}
    result["nll"]["control_file"] = control
    text = json.dumps(result, indent=2) + "\n"
    if args.output:
        with open(args.output, "w") as f:
            f.write(text)
    else:
        sys.stdout.write(text)
    if args.keep:
        print(f"yanll-locate: work directory kept in {workdir}", file=sys.stderr)
    else:
        shutil.rmtree(workdir)
    return 0 if result["nll"]["status"] == "LOCATED" else 1


if __name__ == "__main__":
    sys.exit(main())
