#!/usr/bin/env python3
"""Turn a production NLLOC_OBS observation file into a yanll-locate input document.

The event and origin ids are taken from a file name of the production form
<eventid>_<originid>_version_<v>.phsnll when present.
"""
import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import yanlllib as y  # noqa: E402


def to_json(obs_path, model, dimension, corrections):
    doc = {"model": model, "dimension": dimension, "station_corrections": corrections}
    m = re.match(r"(\d+)_(\d+)_version_\d+\.phsnll$", os.path.basename(obs_path))
    if m:
        doc["event_id"], doc["origin_id"] = m.group(1), m.group(2)
    doc["observations"] = y.read_obs(obs_path)
    return doc


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("obs", help="NLLOC_OBS file")
    ap.add_argument("--model", required=True, help="zone nickname or TOMORAMA-2013")
    ap.add_argument("--dimension", required=True, choices=["1d", "3d"])
    ap.add_argument("--no-corrections", action="store_true", help="station_corrections false (default true)")
    args = ap.parse_args()
    doc = to_json(args.obs, args.model, args.dimension, not args.no_corrections)
    json.dump(doc, sys.stdout, indent=2)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
