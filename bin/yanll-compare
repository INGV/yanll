#!/usr/bin/env python3
"""Locate the fixture events in the container and compare with production.

For every run under the fixtures directory the production NLLoc control file is reused
with only its paths rewritten (observation file, time grids, output root, corrections),
so that what is compared is NLL itself plus the regenerated grids, not an adapter. The
1D run uses the stations of the observation file; the 3D run uses only the stations
that had a real grid in production (the others enter the production location with
weight 0 because of the broken grid generation described in docs/production-flow.md),
so that the two locations see the same phases. With --all-stations a third row per
event locates in 3D with grids for every station, reported but not counted.

Acceptance: epicentre within 1 km, depth within 2 km, origin time within 0.5 s.
"""
import argparse
import datetime as dt
import glob
import math
import os
import re
import subprocess
import sys

TOL_EPI_KM = 1.0
TOL_DEP_KM = 2.0
TOL_OT_S = 0.5
MODEL_3D = "TOMORAMA-2013"
CORR_1D = "/opt/yanll/models_1d/correzioni/correzioni_{zone}.in"
CORR_3D = "/opt/yanll/corrections_3d/corrections_TOMORAMA-2013.in"
# A 109 km deep event at the bottom edge of the 1D grid: kept as a stress case.
STRESS = {"46761811_147805861"}


def parse_hyp(path):
    """The fields of a .grid0.loc.hyp that the comparison needs."""
    out = {"stations": set(), "with_grid": set(), "staloc": {}}
    in_phases = False
    for line in open(path):
        f = line.split()
        if not f:
            continue
        if f[0] == "GEOGRAPHIC":
            out["ot"] = dt.datetime(int(f[2]), int(f[3]), int(f[4]), int(f[5]), int(f[6])) \
                + dt.timedelta(seconds=float(f[7]))
            out["lat"], out["lon"], out["dep"] = float(f[9]), float(f[11]), float(f[13])
        elif f[0] == "QUALITY":
            out["rms"], out["nphs"], out["gap"] = float(f[8]), int(f[10]), float(f[12])
        elif f[0] == "SIGNATURE":
            m = re.search(r"NLLoc:(v[^ ]+)", line)
            out["version"] = m.group(1) if m else "?"
        elif f[0] == "PHASE" and f[1] == "ID":
            in_phases = True
        elif f[0] == "END_PHASE":
            in_phases = False
        elif in_phases:
            out["stations"].add(f[0])
            if float(f[18]) > -1e19:
                out["with_grid"].add(f[0])
                out["staloc"][f[0]] = (float(f[18]), float(f[19]), float(f[20]))
    return out


def hyp_of(dirname):
    hyps = [h for h in glob.glob(os.path.join(dirname, "*.grid0.loc.hyp")) if ".sum." not in h]
    if len(hyps) != 1:
        raise SystemExit(f"expected one .grid0.loc.hyp in {dirname}, found {len(hyps)}")
    return hyps[0]


def zone_of(event_dir):
    ins = glob.glob(os.path.join(event_dir, "loc_1d", "*_nlloc1D_*_loc.in"))
    return re.search(r"_nlloc1D_(.*)_loc\.in$", ins[0]).group(1)


def obs_stations(obs):
    return sorted({line.split()[0] for line in open(obs) if not line.startswith("#")})


def rewrite_control(src, dst, obs, timeroot, outroot, corrections):
    with open(src) as fin, open(dst, "w") as fout:
        for line in fin:
            if line.startswith("LOCFILES"):
                line = f"LOCFILES {obs} NLLOC_OBS {timeroot}  {outroot}\n"
            elif line.startswith("INCLUDE"):
                line = f"INCLUDE {corrections}\n"
            fout.write(line)


def locate(event_dir, run, dim, data, stations):
    """Generate the grids for the stations, run NLLoc, return the parsed hyp."""
    zone = zone_of(event_dir)
    model = MODEL_3D if dim.startswith("3d") else zone
    workdir = os.path.join(data, "compare", run, dim)
    os.makedirs(workdir, exist_ok=True)
    for old in glob.glob(os.path.join(workdir, "*")):
        os.remove(old)
    with open(os.path.join(workdir, "make-grids.log"), "w") as log:
        subprocess.run(["yanll-make-grids", model] + stations, check=True, stdout=log, stderr=subprocess.STDOUT)
    obs = glob.glob(os.path.join(event_dir, "obs", "*.phsnll"))[0]
    if dim.startswith("3d"):
        src = glob.glob(os.path.join(event_dir, "loc_3d", "*_loc.in"))[0]
        timeroot = os.path.join(data, "time_3d", MODEL_3D, "time")
        corrections = CORR_3D
    else:
        src = glob.glob(os.path.join(event_dir, "loc_1d", "*_loc.in"))[0]
        timeroot = os.path.join(data, "time_1d", zone, "time")
        corrections = CORR_1D.format(zone=zone)
    control = os.path.join(workdir, "nlloc.in")
    rewrite_control(src, control, obs, timeroot, os.path.join(workdir, run), corrections)
    with open(os.path.join(workdir, "nlloc.log"), "w") as log:
        subprocess.run(["NLLoc", control], check=True, stdout=log, stderr=subprocess.STDOUT)
    return parse_hyp(hyp_of(workdir))


def epi_km(a, b):
    r = 6371.0
    p1, p2 = math.radians(a["lat"]), math.radians(b["lat"])
    dp, dl = p2 - p1, math.radians(b["lon"] - a["lon"])
    h = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * r * math.asin(math.sqrt(h))


def compare(prod, cont):
    d_epi = epi_km(prod, cont)
    d_dep = cont["dep"] - prod["dep"]
    d_ot = (cont["ot"] - prod["ot"]).total_seconds()
    ok = d_epi <= TOL_EPI_KM and abs(d_dep) <= TOL_DEP_KM and abs(d_ot) <= TOL_OT_S
    # Largest horizontal offset between the station coordinates the two runs used
    # (both in the run's projection): a cross-check of the station snapshot against
    # the coordinates production's grids were generated with.
    common = set(prod["staloc"]) & set(cont["staloc"])
    d_sta = max((math.hypot(prod["staloc"][s][0] - cont["staloc"][s][0],
                            prod["staloc"][s][1] - cont["staloc"][s][1]) for s in common), default=0.0)
    return d_epi, d_dep, d_ot, d_sta, ok


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--fixtures", default="/fixtures/events")
    ap.add_argument("--data", default=os.environ.get("YANLL_DATA", "/data"))
    ap.add_argument("--report", default="/docs/comparison-report.md")
    ap.add_argument("--all-stations", action="store_true", help="add a 3D row with grids for every station")
    ap.add_argument("--dims", default="1d,3d", help="which of 1d,3d to run (default both)")
    ap.add_argument("events", nargs="*", help="runs to compare (default: all)")
    args = ap.parse_args()

    runs = args.events or sorted(os.path.basename(d) for d in glob.glob(os.path.join(args.fixtures, "*")) if os.path.isdir(d))
    rows, versions = [], set()
    for run in runs:
        event_dir = os.path.join(args.fixtures, run)
        zone = zone_of(event_dir)
        obs = glob.glob(os.path.join(event_dir, "obs", "*.phsnll"))[0]
        prod1 = parse_hyp(hyp_of(os.path.join(event_dir, "loc_1d")))
        prod3 = parse_hyp(hyp_of(os.path.join(event_dir, "loc_3d")))
        versions.add(prod1["version"])
        plans = [("1d", prod1, obs_stations(obs)), ("3d", prod3, sorted(prod3["with_grid"]))]
        if args.all_stations:
            plans.append(("3d-all", prod3, obs_stations(obs)))
        plans = [p for p in plans if p[0].split("-")[0] in args.dims.split(",")]
        for dim, prod, stations in plans:
            print(f"{run} {zone} {dim}: {len(stations)} stations", flush=True)
            cont = locate(event_dir, run, dim, args.data, stations)
            versions.add(cont["version"])
            d_epi, d_dep, d_ot, d_sta, ok = compare(prod, cont)
            counted = dim != "3d-all" and run not in STRESS
            rows.append((run, zone, dim, prod, cont, d_epi, d_dep, d_ot, d_sta, ok, counted))
            print(f"  d_epi={d_epi:.2f} km d_dep={d_dep:+.2f} km d_ot={d_ot:+.3f} s d_sta={d_sta:.3f} km nphs={prod['nphs']}/{cont['nphs']} {'PASS' if ok else 'FAIL'}", flush=True)

    counted = [r for r in rows if r[10]]
    failed = [r for r in counted if not r[9]]
    cont_version = ", ".join(sorted(v for v in versions if "27Oct2017" not in v))
    with open(args.report, "w") as out:
        out.write("# Comparison with production\n\n")
        out.write(f"Generated by `yanll-compare` on {dt.datetime.now(dt.timezone.utc):%Y-%m-%d %H:%M} UTC. ")
        out.write(f"Container NLLoc {cont_version}, production NLLoc v7.00.00(27Oct2017). ")
        out.write(f"Tolerances: epicentre {TOL_EPI_KM} km, depth {TOL_DEP_KM} km, origin time {TOL_OT_S} s. ")
        out.write(f"Result: {len(counted) - len(failed)} of {len(counted)} counted locations within tolerance")
        out.write(".\n\n" if not failed else f", {len(failed)} outside.\n\n")
        out.write("`d_epi` is the epicentral distance between the two maximum-likelihood hypocentres, "
                  "`d_dep` and `d_ot` are container minus production. `nphs` is the number of phases "
                  "NLLoc used (production / container), `d_sta` the largest horizontal offset "
                  "between the station coordinates of the two runs. Rows marked `stress` or "
                  "`3d-all` are informative and not counted.\n\n")
        out.write("| run | zone | dim | production lat, lon, depth, OT | container lat, lon, depth, OT | d_epi km | d_dep km | d_ot s | d_sta km | nphs | result |\n")
        out.write("|---|---|---|---|---|---|---|---|---|---|---|\n")
        for run, zone, dim, prod, cont, d_epi, d_dep, d_ot, d_sta, ok, is_counted in rows:
            tag = "PASS" if ok else "FAIL"
            if not is_counted:
                tag += " (stress)" if run in STRESS else " (3d-all)"
            out.write(f"| {run} | {zone} | {dim} | {prod['lat']:.4f}, {prod['lon']:.4f}, {prod['dep']:.2f}, {prod['ot']:%H:%M:%S.%f} "
                      f"| {cont['lat']:.4f}, {cont['lon']:.4f}, {cont['dep']:.2f}, {cont['ot']:%H:%M:%S.%f} "
                      f"| {d_epi:.2f} | {d_dep:+.2f} | {d_ot:+.3f} | {d_sta:.3f} | {prod['nphs']}/{cont['nphs']} | {tag} |\n")
    print(f"report written to {args.report}: {len(counted) - len(failed)}/{len(counted)} within tolerance")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
